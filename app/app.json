{
  "expo": {
    "name": "Gali",
    "slug": "gali",
    "scheme": "gali",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1b1426",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b1426"
    },
    "android": {
      "package": "trade.aeonian.gali",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b1426"
      },
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-build-properties", { "android": { "minSdkVersion": 26, "enableProguardInReleaseBuilds": false } }],
      ["expo-notifications", { "color": "#ffc83d" }],
      "expo-font",
      "expo-audio"
    ]
  }
}
