# Copy to app/.env.local for local builds. Every EXPO_PUBLIC_ value ends up in the app bundle, so never put a secret here.
EXPO_PUBLIC_NETWORK=mainnet
EXPO_PUBLIC_RPC_READ_URL=
EXPO_PUBLIC_RPC_URL=

# Feature flags: 0 (default) hides the feature completely. Keep 0 in release builds.
# The Gali program (points, streaks, BOOST staking, SKR jackpot). Not deployed.
EXPO_PUBLIC_FEATURE_GALI_PROGRAM=0
