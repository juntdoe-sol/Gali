# Copy to app/.env.local: `cp .env.example .env.local`. Expo reads it on start.
# Every EXPO_PUBLIC_ value is bundled into the app, so never put a secret here.
# With only the lines below, the app runs ORE mining on mainnet through the public Solana RPC.

# mainnet = play ORE's live board. Leave it set: any other value runs a devnet build with wallets off.
EXPO_PUBLIC_NETWORK=mainnet

# Optional. Your own Solana RPC for sending transactions. Empty = https://api.mainnet-beta.solana.com
# (rate-limited; switch if you see 429 errors). Use a keyless URL only.
EXPO_PUBLIC_RPC_URL=

# Optional. Gali's read proxy (app/rpc-backend), so no RPC key ships in the app. Empty = reads use EXPO_PUBLIC_RPC_URL.
EXPO_PUBLIC_RPC_READ_URL=
# EXPO_PUBLIC_RPC_READ_URL2=

# Optional. Arcade server URL (app/rpc-backend/functions/games.mjs). Empty = beside the read proxy as /games,
# or the arcade tables show as unavailable when no read proxy is set.
# EXPO_PUBLIC_GAMES_URL=

# Optional. Supabase realtime for the shared lobby, chat and the Arena. Empty = the lobby runs solo.
# EXPO_PUBLIC_WORLD_URL=wss://<project-ref>.supabase.co/realtime/v1
# EXPO_PUBLIC_WORLD_KEY=<supabase anon key>

# Optional. Public half of the Arena ticket key (scripts/ticket-key.mjs). Empty = tickets off.
# EXPO_PUBLIC_TICKET_KEY=

# Feature flags: 0 (default) hides the feature completely. Keep 0 in release builds.
# The Gali program (points, streaks, BOOST staking, SKR jackpot). In development.
EXPO_PUBLIC_FEATURE_GALI_PROGRAM=0
