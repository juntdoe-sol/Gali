# Public values only. Copy to tv/.env. Nothing here is a secret.
EXPO_PUBLIC_NETWORK=mainnet
# Reads go straight to the public RPC (the Bounded read proxy needs app auth and CORS, so it is not used on TV).
EXPO_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Supabase realtime URL and publishable (anon) key, the same ones the phone app ships with.
EXPO_PUBLIC_WORLD_URL=
EXPO_PUBLIC_WORLD_KEY=
